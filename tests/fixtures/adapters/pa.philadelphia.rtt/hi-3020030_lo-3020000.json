 ],
 "sql": "WITH w AS (SELECT DISTINCT document_id FROM rtt_summary WHERE cartodb_id >= 3020000 AND cartodb_id < 3020030), own AS (SELECT w.document_id FROM w WHERE NOT EXISTS (SELECT 1 FROM rtt_summary x WHERE x.document_id = w.document_id AND x.cartodb_id < 3020000)) SELECT r.cartodb_id, r.document_id, r.record_id, r.document_type, r.recording_date, r.document_date, r.grantors, r.grantees, r.total_consideration, r.opa_account_num, r.street_address, r.unit_num, r.zip_code, r.matched_regmap, r.reg_map_id, r.property_count, r.discrepancy FROM rtt_summary r JOIN own USING (document_id) ORDER BY r.document_id, r.cartodb_id"
}
